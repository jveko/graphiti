# Graphiti MCP Server Environment Configuration

# FalkorDB Database Configuration
# These settings are used to connect to your FalkorDB database
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_DATABASE=default_db


# OpenAI API Configuration
# Required for LLM operations
#OPENAI_API_KEY=your_openai_api_key_here
#MODEL_NAME=gpt-4.1-mini
#SMALL_MODEL_NAME=gpt-4.1-nano

# Gemini API Configuration
# Optional: Set this to use Google Gemini AI Studio
GOOGLE_API_KEY=your_google_api_key_here
MODEL_NAME=gemini-2.5-flash
SMALL_MODEL_NAME=gemini-2.5-flash-lite

# OpenRouter Configuration
# Optional: Set this to use OpenRouter for LLM with advanced provider routing
# Uses MODEL_NAME and SMALL_MODEL_NAME for model selection (same as other providers)
#OPENROUTER_API_KEY=your_openrouter_api_key_here
#OPENROUTER_PROVIDER_ORDER=anthropic,openai,google
#OPENROUTER_ALLOW_FALLBACKS=true
#OPENROUTER_PROVIDER_SORT=price

# Groq API Configuration
# Optional: Set this to use Groq for fast LLM inference
# Supports structured outputs on compatible models (moonshotai/kimi-k2-instruct-0905, etc.)
#GROQ_API_KEY=your_groq_api_key_here
#MODEL_NAME=llama-3.3-70b-versatile
#SMALL_MODEL_NAME=llama-3.1-8b-instant

# Voyage AI Configuration
# Optional: Set this to use Voyage AI for embeddings
VOYAGE_API_KEY=your_voyage_api_key_here
EMBEDDER_MODEL_NAME=voyage-3.5-lite
RERANKER_MODEL_NAME=rerank-2.5-lite


# Optional: Only needed for non-standard OpenAI endpoints
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: Group ID for namespacing graph data
GROUP_ID=my_project

# Optional: Path configuration for Docker
PATH=/root/.local/bin:${PATH}

# Optional: Semaphore limit for concurrent operations
SEMAPHORE_LIMIT=10

# Retry Configuration for Episode Processing
# These settings control how the server handles failed episode processing attempts
# Maximum number of retry attempts for failed episodes (default: 2)
MAX_RETRY_ATTEMPTS=2
# Base delay in seconds for exponential backoff (default: 1.0)
RETRY_BASE_DELAY=1.0
# Maximum delay cap in seconds to prevent excessively long waits (default: 60.0)
RETRY_MAX_DELAY=60.0
# Enable jitter to prevent thundering herd problem (default: true)
RETRY_JITTER=true
